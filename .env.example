# =============================================================================
# Calibrated Agency — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NOT be committed.
# =============================================================================

# --- HuggingFace access (required for Llama-3 downloads) ---
HF_TOKEN=hf_your_token_here

# --- AgentBench SQLite path (for DB tasks, the final thesis benchmark) ---
AGENTBENCH_DB_PATH=/tmp/agentbench_db.sqlite

# --- LRZ cluster: local model weights directory (used by scripts/lrz/*) ---
# LRZ_MODEL_DIR=/path/to/your/models

# --- Excluded from the final thesis scope (AgentBench-OS / ToolBench), kept only
#     for the archived code under legacy/ — see legacy/README.md ---
# RAPIDAPI_KEY=
# TOOLBENCH_SERVER=http://localhost:5000
# BASH_TIMEOUT=15

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=file:./mlruns
WANDB_PROJECT=calibrated_agency
# WANDB_API_KEY=your_key_here

# --- Logging ---
LOG_LEVEL=INFO
