# Force LF line endings for files that run on Linux (SLURM / LRZ cluster).
# Without this, Windows git checkouts produce CRLF which sbatch rejects.

*.sh        text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env*      text eol=lf
Makefile    text eol=lf
